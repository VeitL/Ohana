      "owner": "Care services owner",
      "risk": "cross-feature",
      "activationTriggers": [
        "care event command",
        "reminder completion or skip",
        "calendar route visible",
        "notification action"
      ],
      "routes": [
        "CalendarView",
        "ReminderActionCoordinator",
        "FocusHomeReminderDeepLinkRouter"
      ],
      "services": [
        "CareEventService",
        "CareLedgerService",
        "ReminderSchedulingService",
        "ReminderMaintenanceService",
        "ReminderNotificationScheduling"
      ],
      "readModels": [
        "CareLedgerStatsService",
        "CareLedgerAnalysisView",
        "ReminderObservabilityView"
      ],
      "tests": [
        "OhanaTests/CareLedgerBackfillActorTests.swift",
        "OhanaTests/ReminderActionCoordinatorTests.swift",
        "OhanaTests/ReminderMaintenanceServiceTests.swift",
        "OhanaTests/OhanaNotificationsSchedulingTests.swift"
      ],
      "sloIds": [
        "quick-care-command",
        "calendar-agenda-refresh"
      ],
      "businessWriteBoundary": "One domain service records the care/reminder fact; reminders, ledger, rewards, and read-model revisions synchronize after commit.",
      "ownedPaths": [
        "Ohana/Features/Home/HomeCommandExecutor.swift",
        "Ohana/Features/Home/ExpandedQuickActionExecutor.swift",
