        "Ohana/Features/Calendar/Views/CalendarView.swift"
      ]
    },
    {
      "id": "backup-privacy-reset",
      "owner": "Privacy and data safety owner",
      "risk": "release-risk",
      "activationTriggers": [
        "settings backup export",
        "settings backup import",
        "delete my data",
        "privacy/PIN state change"
      ],
      "routes": [
        "SettingsView",
        "HumanAccountPrivacyViews"
      ],
      "services": [
        "DataBackupManager",
        "AppResetService",
        "PrivacyService"
      ],
      "readModels": [
        "MetricDiagnosticsStore",
        "privacy placeholders in account/profile surfaces"
      ],
      "tests": [
        "OhanaTests/AppResetServiceTests.swift",
        "OhanaTests/OhanaTests.swift"
      ],
      "sloIds": [
        "backup-export",
        "delete-my-data"
      ],
      "businessWriteBoundary": "Export/import/delete flows go through domain services; views must not manually serialize sensitive model fields or bypass privacy filters.",
      "ownedPaths": [
        "Ohana/Domain/Services/DataBackupManager.swift",
        "Ohana/Domain/Services/DataBackupDTOs.swift",
        "Ohana/Features/Privacy/PrivacyService.swift",
