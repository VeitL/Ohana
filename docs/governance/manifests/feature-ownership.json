  "features": [
    {
      "id": "focus-home-workbench",
      "owner": "Home feature owner",
      "risk": "interaction-heavy",
      "activationTriggers": [
        "root route visible",
        "home tab selected",
        "home card expanded",
        "quick action selected"
      ],
      "routes": [
        "HomeRouteCoordinator",
        "FocusHomeRouteSheetModifier",
        "FocusHomeExpandedQuickRouteRouter"
      ],
      "services": [
        "HomeCommandExecutor",
        "CareEventService",
        "FamilyTaskService",
        "CoconutEconomyService or QuestManager reward pipeline"
      ],
      "readModels": [
        "HomeSnapshotBuilder",
        "VerticalSolidHomeSnapshotBuilder",
        "HomeReadModelStore"
      ],
      "tests": [
        "OhanaTests/HomeRouteCoordinatorTests.swift",
        "OhanaTests/HomeSnapshotBuilderTests.swift",
        "OhanaTests/HomeReadModelStoreTests.swift",
        "OhanaTests/VerticalSolidHomeControllerTests.swift"
      ],
      "sloIds": [
        "home-card-expand",
        "tab-switch-home"
      ],
      "businessWriteBoundary": "Views emit user intent; service/command executor writes one business fact and downstream services fan out.",
      "ownedPaths": [
        "Ohana/Features/Home",
        "Ohana/Features/Feeding/Views/QuickFeedHomePresenter.swift",
        "Ohana/Features/Feeding/QuickFeedHomeSnapshot.swift"
      ]
    },
    {
