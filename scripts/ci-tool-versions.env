# Pinned toolchain expectations for CI and local development.
#
# Why: `brew install` always delivers the latest version, so lint/audit results
# can change under you without any commit ("green CI turns red on a Tuesday",
# or worse, silently turns lenient). scripts/check-tool-versions.sh compares
# the installed tools against these pins and fails on drift, converting silent
# drift into a deliberate one-line bump that goes through review.
#
# To bump: update the value here after reading the tool's changelog, run the
# lint/audit suite locally, and commit the pin change together with any fixes.
#
# Match levels: MAJOR_MINOR ignores the patch component; MAJOR only checks the
# first component.

SWIFTLINT_PINNED="0.65"
SWIFTLINT_MATCH="MAJOR_MINOR"

SWIFTFORMAT_PINNED="0.62"
SWIFTFORMAT_MATCH="MAJOR_MINOR"

RIPGREP_PINNED="15"
RIPGREP_MATCH="MAJOR"

GITLEAKS_PINNED="8"
GITLEAKS_MATCH="MAJOR"
