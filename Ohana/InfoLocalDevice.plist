<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.guanchen.li.Ohana.LocalDevice.system-surfaces</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ohana-local</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>用于拍摄成员或宠物头像，以及记录时刻中的照片。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>用于在切换成员资料时快速通过本人验证，替代输入 PIN。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>用于在你主动连接 Apple Health 时读取步数、距离、活动能量和运动记录，并在本机生成此成员的运动摘要。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择成员或宠物头像，以及记录附件图片。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于在「记录时刻」中附加当前地点，以及在你主动开始遛狗时记录路线。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>仅当你开始遛狗时，用于切到后台或锁屏后继续记录本次路线。</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>仅当你开始遛狗并需要锁屏或后台继续记录路线时使用。</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.guanchen.li.Ohana.reminderRefill</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
	</array>
</dict>
</plist>
